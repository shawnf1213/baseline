# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Secrets and local config — never committed (EAS env holds the real values)
.env
.env.*
!.env.example
# EAS local artefacts
*.ipa
*.apk
*.aab

# web export used only for store screenshots
dist-web/

# App Store Connect API key and other local-only credentials
.secrets/

# EAS local signing credentials (points into .secrets/)
credentials.json

# raw app captures that store_frames.mjs composes into the store frames
store/raw/
