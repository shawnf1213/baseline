# Copy to .env (gitignored). Only EXPO_PUBLIC_* values are read by the app, and
# they ship inside the bundle — so NOTHING secret belongs in this file. Secrets
# (Apple credentials, push keys, service tokens) live in EAS environment
# variables, never here and never in the repo.
EXPO_PUBLIC_API_URL=https://backend-production-84ab.up.railway.app
EXPO_PUBLIC_ENV=development
